# Notylus Landing Page Environment Variables
# Copy this file to .env for local development

# Main app URL - uncomment and set for local testing
# PUBLIC_APP_URL=http://localhost:5173

# Production (default if not set)
# PUBLIC_APP_URL=https://app.notylus.net

# Supabase project — used only to read public.app_status_banner (the
# reconstruction/Beta header notice's DB-backed on/off flag). Same project
# and anon key the main app (translit-pro repo) uses — copy the values from
# its VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
