---
import { buildAppUrl } from '../config';
---

<section class="relative py-20 sm:py-28 overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-b from-slate-900 to-indigo-900/30"></div>
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-indigo-500/15 rounded-full blur-3xl"></div>

  <div class="relative max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-3xl sm:text-4xl font-bold text-white mb-5">
      Start with one note in one other language
    </h2>
    <p class="text-lg text-slate-400 mb-9">
      The free plan does not ask for a card. Bring your notes over whenever you
      decide it is working.
    </p>
    <a
      href={buildAppUrl('/signup')}
      class="inline-flex items-center justify-center px-8 py-4 text-lg font-semibold text-white bg-indigo-600 hover:bg-indigo-500 rounded-xl shadow-lg shadow-indigo-500/25 transition-all hover:shadow-indigo-500/40"
    >
      Start Free
      <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
      </svg>
    </a>
  </div>
</section>
