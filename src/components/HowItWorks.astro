---
import { buildAppUrl, TRANSLITPRO_SITE_URL } from '../config';

const workflow = [
  { label: 'Capture', title: 'Clip or jot it down', body: 'One click from the extension, or a note typed straight into the popup.' },
  { label: 'Organize', title: 'It files itself', body: 'Spaces, folders, and language tags are applied as it lands — not later.' },
  { label: 'Retrieve', title: 'Find it in any language', body: 'Search, filter by language, then export or keep writing where you left off.' },
];
---

<section id="how-it-works" class="py-20 sm:py-32 bg-slate-800/25 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div>
        <p class="text-sm font-semibold text-cyan-400 uppercase tracking-wider mb-3">From scattered to searchable</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-6">Everything you save ends up somewhere you can find it</h2>
        <p class="text-lg text-slate-400 leading-relaxed mb-8">
          Notylus runs in the browser and in the extension, so capture happens
          where you already are. Typing in another script is powered by the same
          engine behind <a href={TRANSLITPRO_SITE_URL} class="text-indigo-300 hover:text-indigo-200 underline decoration-indigo-500/40">TranslitPro</a>.
        </p>

        <div class="space-y-5 mb-8">
          {workflow.map((step, index) => (
            <div class="flex gap-4">
              <div class="w-10 h-10 rounded-xl bg-indigo-500/15 border border-indigo-500/20 text-indigo-200 flex items-center justify-center font-bold flex-shrink-0">
                {index + 1}
              </div>
              <div>
                <div class="text-xs uppercase tracking-wider text-slate-500 mb-1">{step.label}</div>
                <h3 class="text-lg font-semibold text-white mb-1">{step.title}</h3>
                <p class="text-slate-400 text-sm leading-relaxed">{step.body}</p>
              </div>
            </div>
          ))}
        </div>

        <a
          href={buildAppUrl('/signup')}
          class="inline-flex items-center justify-center px-6 py-3 text-base font-semibold text-white bg-indigo-600 hover:bg-indigo-500 rounded-xl shadow-lg shadow-indigo-500/20 transition-all"
        >
          Try Notylus
          <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      </div>

      <div class="relative">
        <div class="absolute -inset-4 bg-cyan-500/10 rounded-3xl blur-2xl"></div>
        <div class="relative rounded-3xl border border-slate-700/60 bg-slate-950/80 p-5 shadow-2xl">
          <div class="rounded-2xl border border-slate-800 bg-slate-900 p-4 mb-4">
            <div class="flex items-center justify-between mb-4">
              <span class="text-sm font-semibold text-white">Save to Notylus</span>
              <span class="text-xs text-emerald-300 bg-emerald-500/10 px-2 py-1 rounded-full">Clipped</span>
            </div>
            <div class="space-y-3">
              <div class="h-3 w-4/5 rounded-full bg-slate-700"></div>
              <div class="h-3 w-full rounded-full bg-slate-700"></div>
              <div class="h-3 w-2/3 rounded-full bg-slate-700"></div>
            </div>
          </div>

          <div class="grid sm:grid-cols-2 gap-4">
            <div class="rounded-2xl border border-indigo-500/20 bg-indigo-500/10 p-4">
              <div class="text-sm font-semibold text-indigo-200 mb-2">You type</div>
              <p class="font-mono text-sm text-slate-400 notranslate" translate="no">Ya pishu na neskolkih yazykah...</p>
            </div>
            <div class="rounded-2xl border border-emerald-500/20 bg-emerald-500/10 p-4">
              <div class="text-sm font-semibold text-emerald-200 mb-2">You get</div>
              <p class="font-mono text-sm text-slate-200 notranslate" translate="no">Я пишу на нескольких языках...</p>
            </div>
          </div>

          <div class="mt-4 rounded-2xl border border-cyan-500/20 bg-cyan-500/10 p-4">
            <div class="text-sm font-semibold text-cyan-200 mb-2">Then</div>
            <div class="flex flex-wrap gap-2">
              {['Fix spelling', 'Rewrite', 'Tag by language', 'Export PDF'].map((item) => (
                <span class="px-3 py-1 text-xs rounded-full bg-slate-900/80 text-slate-300 border border-slate-700">{item}</span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
